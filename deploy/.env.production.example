# ============================================================
# Libevra — 生产环境变量模板
#
# ⚠️ 用法：复制到 deploy/.env，然后**把每一个值都换掉**。
#
#    cp deploy/.env.production.example deploy/.env
#
# ⚠️ **deploy/.env 永远不进 Git。** `.gitignore` 已经排除它（见仓库根 `.gitignore`）。
#    这份模板里**没有任何真实口令**，只有占位符——模板进了仓库，所以模板必须是安全的。
#
# ⚠️ **生产与开发不共用任何凭据。**
#    本机开发库的口令、`SESSION_SECRET`、数据库名都在仓库根的 `.env` 里，
#    **一个都不应该被复制到这里**。生产库是一个独立的库，用独立的密钥。
#
# ⚠️ **管理员不在这个文件里。** 生产环境的第一个管理员由所有者在服务器上按
#    `docs/S12-A上线前安全与发布准备.md` §7 的步骤建立，
#    **本机开发库 `naeor` 的 UUID 不会、也不应该出现在这份模板中。**
# ============================================================

# ---- 数据库（容器内部网络，不暴露公网端口）----
# ⚠️ 主机名是 **db**，也就是 compose 里的服务名。
#    写成 `127.0.0.1` 会让 API 去连它自己的容器，而不是数据库容器。
POSTGRES_USER=libevra
POSTGRES_PASSWORD=CHANGE_ME_长随机口令
POSTGRES_DB=libevra_prod

# ⚠️ 供 Prisma 使用。口令必须与上面的 POSTGRES_PASSWORD **完全一致**。
#    生成口令：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DATABASE_URL=postgresql://libevra:CHANGE_ME_长随机口令@db:5432/libevra_prod?schema=public

# ---- 会话签名密钥 ----
# ⚠️ **必须重新生成，绝不要沿用开发环境的那个。**
#    生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64位十六进制

# ---- 站点地址 ----
# ⚠️ **域名在这里，不在 Caddyfile 里。** 两处都要填同一个值。
#    Caddy 用它申请证书；API 用它做同源校验。
LIBEVRA_DOMAIN=CHANGE_ME.example.com
WEB_ORIGIN=https://CHANGE_ME.example.com

# ---- Let's Encrypt 通知邮箱 ----
# ⚠️ 用于证书到期提醒。留空能跑，但**证书出问题时你不会收到任何通知**。
ACME_EMAIL=CHANGE_ME@example.com

# ---- 服务 ----
# ⚠️ 容器内必须监听 0.0.0.0，否则反向代理连不上。
API_HOST=0.0.0.0
API_PORT=3000

# ---- 语音识别 ----
# ⚠️ `small` 约 488 MB，首次使用时下载到 `api-data` 卷里。
#    2 GB 内存的服务器上这是上限；`base`（148 MB）更快但中文更容易错。
LIBELLUM_WHISPER_MODEL=small
LIBELLUM_WHISPER_THREADS=2

# ---- 演示账号（S12-B 上线时使用）----
# ⚠️ 只读演示账号在服务端拦截写操作。**上线前必须把口令改掉。**
DEMO_USERNAME=demo
DEMO_PASSWORD=CHANGE_ME_演示账号口令
