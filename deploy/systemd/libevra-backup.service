# Libevra — 每日备份的一次执行。
#
# ⚠️ **为什么是 systemd timer 而不是 cron**（见 docs/开发过程记录/S12-C-自动备份-审计与设计.md §2）：
# `Persistent=true` 能让**关机期间错过的 03:00 在开机后补跑一次**，cron 不能。
#
# ⚠️ **安装方式见 deploy/README.md**：这里只是仓库里的副本，
# 服务器上的正式位置是 /etc/systemd/system/。
[Unit]
Description=Libevra production backup (dump + verify + encrypt + offsite + status)
Documentation=file:/srv/libevra/docs/生产环境与运维手册.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/libevra/deploy

# ⚠️ **flock 是第二道保险**：systemd 保证同一个 unit 不并发启动，
# 但**手动执行**是常见动作，而两次同时跑会争磁盘与数据库连接。
ExecStart=/usr/bin/flock -n /srv/libevra/deploy/.backup.lock /srv/libevra/deploy/backup-all.sh

# 备份最多一小时；超时视为失败（会在 journal 与状态文件里留下痕迹）。
TimeoutStartSec=1h

# 备份是低优先级任务：不要跟 API 抢 CPU/IO。
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# 输出进 journal：`journalctl -u libevra-backup -n 100 --no-pager`
StandardOutput=journal
StandardError=journal
