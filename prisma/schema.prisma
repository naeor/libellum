// Libevra database schema (the project was called Libellum until 2026-10-14).
//
// ⚠️ **The rename stops at this comment line.** The PostgreSQL database name, every table
// name, every column name and every migration are unbranded or deliberately unchanged, so
// nothing in this schema is keyed by either product name — see
// `docs/Libevra品牌迁移记录.md` §6.
//
// Design notes that matter (see docs/PLAN.md section 5):
//  * money is stored as an integer number of cents, never as a float
//  * every business table carries a book_id, and permissions are decided by
//    book_members alone
//  * v1 gives every account its own book; the Book/BookMember tables already
//    exist so that v2 can add sharing without a data migration
//  * rows are never hard-deleted: soft delete plus a version column is what
//    lets an offline client sync without resurrecting deleted data

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  /// Eight-digit public account number, for example `48213907`.
  ///
  /// The UUID above is internal. This is the identifier a person reads aloud,
  /// types on a phone and shares so someone else can find them to share a
  /// ledger.
  ///
  /// ⚠️ **The original design was random, and that has changed** (2026-10-10,
  /// at the owner's request). Numbers are now allocated in sequence by a
  /// server-side counter, so they can be planned and handed out — which is what
  /// the owner wanted: a block was reserved for the first batch of invite codes,
  /// and everything after it continues from there.
  ///
  /// The cost of the change is stated rather than hidden: **a sequential number
  /// can be enumerated.** Anyone who knows one number can guess its neighbours,
  /// where a random one told them nothing. That was the original reason for
  /// random, and the owner accepted the trade in exchange for numbers that can
  /// be allocated in advance. Search-by-number is rate-limited for that reason.
  accountNumber String  @unique @map("account_number")
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isDemo       Boolean  @default(false) @map("is_demo")

  /// May see every ledger, not only the ones they belong to.
  ///
  /// Granted from the account number an invite carried at registration: the
  /// owner reserved a block of numbers for the first batch of codes, and the
  /// people he handed those codes to are the administrators.
  ///
  /// A stored flag rather than a test on the number's range. A range test would
  /// silently extend the privilege to whoever is allocated inside that range
  /// later, and privileges that grow by accident are how a system acquires
  /// administrators nobody chose.
  isAdmin      Boolean  @default(false) @map("is_admin")

  /// The ledger this account looked at last, so signing in returns to it.
  ///
  /// ⚠️ **This is a preference about the account, not about a device**, which is
  /// why it lives here: the owner asked to come back to the ledger he was
  /// working in, and that should hold on a new phone too, not only on the one
  /// that happened to store it locally.
  ///
  /// ⚠️ **Nullable, and nothing backfills it.** Empty means "has not chosen
  /// yet", and the application falls back to the oldest membership — the same
  /// answer the old code gave, so nothing changes for the two accounts that
  /// exist today. Filling it in the migration would have meant writing somebody's
  /// UUID into a SQL file.
  ///
  /// `ON DELETE SET NULL` (see the migration): deleting a ledger should leave
  /// "last used" empty rather than block the delete.
  lastBookId String? @map("last_book_id") @db.Uuid

  /// Existing accounts skip the welcome; registration explicitly opts new accounts in.
  /// Completed only after the ledger space settles at its list, independently of lastBookId.
  hasCompletedIntro Boolean @default(true) @map("has_completed_intro")

  /// The currency this account treats as primary. It sorts first in every
  /// currency list, and once exchange rates exist it is what other currencies
  /// will be converted into. Stored per account rather than per book because it
  /// is a preference about how the owner thinks about money, not about a ledger.
  defaultCurrency String @default("CNY") @map("default_currency") @db.VarChar(3)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Hash of the one-time recovery code. The plaintext is shown exactly once,
  /// when it is created, and can never be recovered from the database again.
  recoveryCodeHash   String?   @map("recovery_code_hash")
  recoveryCodeUsedAt DateTime? @map("recovery_code_used_at") @db.Timestamptz(6)

  /// ⚠️ **One per signed-in device**, so this is a list and not a single row — see Session.
  sessions Session[]
  invite  RegistrationInvite?

  createdBooks    Book[]        @relation("BookCreator")
  bookMemberships BookMember[]
  transactions    Transaction[]
  exportLogs      ExportLog[]
  importLogs      ImportLog[]

  /// The book named by `lastBookId`. Named separately from `createdBooks`
  /// because it is a different relationship: one is "books I made", this is
  /// "the one I was last in", and a person can be in a book they did not create.
  lastBook Book? @relation("UserLastBook", fields: [lastBookId], references: [id], onDelete: SetNull)

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")
  notificationQuotas    NotificationQuota[]
  createdShareLinks     BookShareLink[]   @relation("ShareLinkCreator")
  revokedShareLinks     BookShareLink[]   @relation("ShareLinkRevoker")
  /// Referral codes this account minted. `SetNull` on delete — see the migration: the codes are
  /// how other accounts came to exist, so they outlive the person who handed them out.
  referralCodes         RegistrationInvite[] @relation("ReferralGenerator")
  /// ⚠️ Actions this account took, as recorded in the ledger history. `SetNull` on delete — a
  /// closed account does not un-happen what it did.
  transactionEvents     TransactionEvent[]
  /// ⚠️ 他在这本账里说过的话。`SetNull` 不适用——留言带 `senderName` 快照，
  /// 所以账号注销时用 `Cascade` 删掉是安全的：署名早已存在每一条留言上。
  bookMessages          BookMessage[]

  /// **Who invited me here**, when I registered with their referral code. Null for everybody else.
  ///
  /// ⚠️ **It lives on the user rather than only on the code**, because the seven-day reminder is
  /// *about me and addressed to me*: every visit to the collaborator screen asks "is there an
  /// unhandled referral reminder?", and deriving that by searching `registration_invites` for
  /// `used_by_user_id = me` would store **a fact about me in a table about codes**.
  ///
  /// ⚠️ **`SetNull` on delete**: the inviter closing their account must not take the invited
  /// account with it. The relationship ends — the reminder stops meaning anything — but "I was
  /// invited by somebody" stays as a fact, corroborated independently by
  /// `RegistrationInvite.usedByUserId`.
  referredByUserId String? @map("referred_by_user_id") @db.Uuid
  referredBy       User?   @relation("ReferralInvitee", fields: [referredByUserId], references: [id], onDelete: SetNull)
  /// The other side: accounts that arrived through one of my referral codes.
  invitedUsers     User[]  @relation("ReferralInvitee")

  /// **Platform administration, explicitly granted to this account** — see `AdminGrant`.
  ///
  /// ⚠️ **`isAdmin` above is the marker; this row is the authorization.** They are two
  /// different things on purpose: the boolean is a flag on the user, and the grant is a
  /// dated record of a decision that can be revoked on its own. The admin guard requires
  /// both, plus the account-number range, plus the user being on the allow list — see
  /// `apps/api/src/admin/guard.ts`.
  adminGrant AdminGrant?

  /// **The second, independent half of the admin check** — see `AdminAllowEntry`.
  ///
  /// ⚠️ **A different table, not a different query.** An account must be *listed* here as
  /// well as *granted* above; a grant alone is not enough, which is the whole point of the
  /// second check. See `docs/管理员与权限边界-设计决定.md` §4.
  adminAllowEntry AdminAllowEntry?

  @@map("users")
}

/// **One message waiting for one person to decide.**
///
/// Two kinds remain: an invitation into a ledger, and the seven-day reminder that follows using
/// somebody's referral code.
///
/// ⚠️ **There used to be a third — a request to become an account-level "collaborator" — and it was
/// removed in 1.10.05.** The owner's decision: a ledger is like a group chat, so an invitation
/// belongs to the ledger and needs no account-level relationship in front of it. See the migration
/// `remove_account_level_collaborators`.
///
/// ⚠️ **`bookId` is nullable and that is meaningful**: the referral reminder belongs to **no
/// ledger**, and it is now the only kind that can say so. Borrowing a fake ledger would make
/// "which ledger is this about" a lie that has to be explained.
///
/// ⚠️ **There is no `expired` status.** Expiry is computed from `expiresAt`, never stored: a status
/// that needs a scheduled job to become true is wrong on any day the job does not run.
///
/// ⚠️ **`message` is bounded** because it is free text shown to somebody else — unbounded text is a
/// channel that the quota exists to keep small.
model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  senderId    String   @map("sender_id") @db.Uuid
  bookId      String?  @map("book_id") @db.Uuid
  kind        String   @db.VarChar(32)
  message     String?  @db.VarChar(200)
  /// ⚠️ **What accepting this notification will do** — currently `{ "role": "editor" | "viewer" }`
  /// for a ledger invitation. It has to travel *with* the invitation, because at the moment the
  /// recipient accepts there is nowhere else the server could learn the intended role from, and
  /// guessing would silently widen the permission somebody asked for. Nullable, and a null is read
  /// as the historical default — so old rows stay decidable.
  payload     Json?
  status      String   @default("pending") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User  @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  /// Deleting a ledger removes its invitations; **disposing of one does not** — disposing is not
  /// deleting, so the notification stays.
  book      Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, createdAt])
  @@index([senderId, recipientId, bookId])
  @@map("notifications")
}

/// **How many notifications one account may send in a day.**
///
/// Two ceilings, both the owner's: **five per day to any one account**, and **twenty per day in
/// total**. Share links are deliberately **not** counted — *"分享链接不算"* — because a link is
/// opened by the invited person rather than pushed at them, and counting it would eat the quota
/// that exists to stop harassment.
///
/// ⚠️ **Aggregated per (sender, subject, day) rather than one row per notification**, so that
/// "check and increment" is a single `UPDATE ... WHERE used < limit`: zero rows affected means the
/// ceiling was reached. Counting rows first and inserting second leaves a window — and that window
/// is exactly when two people send their fifth message.
model NotificationQuota {
  userId    String   @map("user_id") @db.Uuid
  /// ⚠️ An all-zero UUID means "the total across everybody", not NULL — see the migration: a NULL
  /// would not be constrained by the primary key, so concurrent writers could create two totals.
  subjectId String   @map("subject_id") @db.Uuid
  day       DateTime @db.Date
  used      Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, subjectId, day])
  @@map("notification_quota")
}

/// A login session.
///
/// ⚠️ **One row per signed-in device.** `user_id` is deliberately **not** unique:
/// it used to be, and that made signing in on one device replace every other
/// device's session. Two devices on one account is the ordinary case, and it is
/// the case the offline conflict handling was built for.
///
/// Only the hash of the session token is stored, so a database leak cannot be
/// replayed as a valid session.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ⚠️ Kept because this is looked up on every authenticated request.
  @@index([userId])
  @@map("sessions")
}

/// Single-use code required to create an account.
///
/// The project is open source but deliberately not open registration: running
/// the server costs money and the tool is meant for a family, so accounts are
/// created with an invite generated by the owner.
///
/// An invite may carry the account number it will grant (`accountNumber`). That
/// is what lets a batch of codes be written down and handed out months before
/// anyone uses them: the number is reserved at generation time by the counter
/// below, not decided at registration.
model RegistrationInvite {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  /// The account number this code will grant, reserved when the code was made.
  /// Null for a code generated before numbers were pre-allocated.
  accountNumber String? @unique @map("account_number")

  /// Whether redeeming this code **reserves a first-batch account number**.
  ///
  /// ⚠️ **This column used to grant administration at registration, and it no longer does**
  /// (2026-10-14, 1.10.22). Two separate problems met here:
  ///
  ///  * **It was an automatic path to administrator.** Anyone holding one of the 98 codes
  ///    the owner had printed (numbers `10000002`–`10000099`) could register and become an
  ///    administrator **without anybody deciding so at that moment** — and those codes never
  ///    expire and were meant to be handed out over months. A privilege that a piece of paper
  ///    confers is a privilege nobody is holding.
  ///  * **Both facts are better expressed elsewhere now.** "This is a first-batch number" is
  ///    the account-number range, and "this account administers the platform" is an
  ///    `AdminGrant` row. Neither needs to be carried on the code.
  ///
  /// **The flag is kept because the numbers it reserved are still real** — clearing the
  /// numbers would lose the reservation — but nothing reads it to decide a privilege.
  /// The migration that made this change also cleared the unused rows, so the database no
  /// longer claims these codes promote anybody.
  ///
  /// See `docs/管理员与权限边界-设计决定.md`.
  grantsAdmin Boolean @default(false) @map("grants_admin")

  /// When the code was withdrawn before anybody used it.
  ///
  /// The owner asked for revocation on 2026-10-10, alongside a default life of
  /// seven days for ordinary codes. Both exist because a code is a **credential
  /// that sits in a chat window**: the useful life of "here, register with this"
  /// is days, not months, and the person who sent it needs a way to take it
  /// back when it reaches the wrong person.
  ///
  /// A timestamp rather than a boolean, so the record says *when* — which is
  /// what somebody auditing the code will want to know, and what a boolean
  /// would have thrown away.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  usedByUserId String?   @unique @map("used_by_user_id") @db.Uuid
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)

  usedBy User? @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  /// Whether the **new account may add the code's generator as a collaborator directly**.
  ///
  /// ⚠️ **This is the generator's choice, and it belongs on the code rather than on the person.**
  /// The owner's rule: a referral code is *"不与任何账本绑定"* and *"只产生'协作者关系'的入口"*,
  /// and the generator decides *at the moment of minting* whether the newcomer may add them
  /// straight away. One account can mint several codes with different answers, which is only
  /// expressible per-code.
  ///
  /// ⚠️ **Defaults to `false`, the more conservative answer.** A code somebody forgot to configure
  /// must not become a one-click door to their collaborator list; opening it up is a deliberate
  /// tick. **A default that grants is a default that will be granted by accident.**

  /// **Who minted this code**, when it is a *referral* code rather than a plain invitation.
  ///
  /// ⚠️ **Registration codes used to be anonymous, and that was correct**: a batch-minted code is
  /// just a ticket, and who made it does not matter. **A referral code is different — it is the
  /// carrier of an invitation relationship**, so its generator is part of what it *is*:
  ///
  /// 1. after registration there would otherwise be nothing to remind the newcomer about;
  /// 2. the collaborator relationship could not be created;
  /// 3. "who can they add?" would have no answer.
  ///
  /// ⚠️ **Null for every existing code**, and a null is read as "not a referral code" — so this
  /// change has **no effect on any code that already exists**.
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdBy User? @relation("ReferralGenerator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@map("registration_invites")
}

/// **A share link into one ledger — stored as a hash, and revocable.**
///
/// ⚠️ **Only the hash is kept.** The plaintext token is returned once, when it is generated, and
/// the server cannot recover it afterwards — so a complete copy of the database still cannot be
/// used to open somebody's ledger. The same rule as recovery codes and session tokens.
///
/// ⚠️ **No salt and no slow hash, deliberately.** The token is a server-generated 256-bit random
/// value, not a chosen password: there is no dictionary to guess, so a slow hash would only make
/// opening a link slower. This is the opposite of `passwordHash`, which must be slow — the two
/// look alike and must not be swapped.
///
/// ⚠️ **One row per link, not per ledger.** "Revoke it" and "regenerate it, the old one stops
/// working" both require **several links for one ledger to coexist** — the revoked one and the live
/// one — which a one-row-per-ledger shape cannot express without a second history table.
model BookShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  /// ⚠️ A hash. The column is named so that nobody later puts a plaintext token in it.
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  bookId    String   @map("book_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  /// What joining through this link grants: the owner's "viewer 或 editor".
  role      String   @default("viewer") @db.VarChar(16)

  /// ⚠️ **How long the link lasts, in days: `1–7`, chosen when it is generated.**
  ///
  /// ⚠️ **The chosen *number of days* is stored, not an absolute expiry.** `createdAt + days` gives
  /// the deadline, and the list can still say "this was a 3-day link" — which an absolute timestamp
  /// would only allow somebody to back-calculate.
  ///
  /// ⚠️ **`7` is the default so that existing rows get the *permissive* end of the range.** A
  /// migration that turned live links into `0`-day links would break something people are holding.
  days      Int      @default(7)

  /// ⚠️ **How many people may join through it: `1–10`.** Once `useCount` reaches this, joining is
  /// refused — **that is the owner's S9 acceptance criterion *"分享链接过期/撤销/满员后无法再加入"*,
  /// and the "满员" half had been missing entirely.**
  ///
  /// ⚠️ **A cap defends against something "revoke" cannot**: revocation is what you do *after*
  /// noticing a link went somewhere you did not intend. **A limit is what stops the eleventh person
  /// from walking in while you are still asleep.**
  maxUses   Int      @default(10) @map("max_uses")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Null means still live; a timestamp means revoked **and says when**.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy   String?   @map("revoked_by") @db.Uuid
  useCount    Int       @default(0) @map("use_count")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)

  book    Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  creator User  @relation("ShareLinkCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  revoker User? @relation("ShareLinkRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  /// ⚠️ Every open asks "which ledger is this hash for, and is it still live" — so the lookup is
  /// `tokenHash` (unique, above) and the listing is by book.
  @@index([bookId, revokedAt])
  @@map("book_share_links")
}

/// **编辑历史：谁在什么时候，对哪一笔账目做了什么修改。**
///
/// ⚠️ **The owner's framing decides the whole design**: *"编辑历史的主要目的**不是复杂的版本管理**，
/// 而是让用户能够明确知道：谁在什么时候，对哪一笔账目做了什么修改."* So this is an audit trail
/// written to be **read by a person**, not a version store to roll back to.
///
/// ⚠️ **A separate table from `Transaction.valueHistory`, deliberately.** `valueHistory` already
/// exists and is **for conflict judgement** — raw material whose reader is an algorithm. This one's
/// reader is a human and its requirement is *"简洁、易读"*; putting both in one field would force a
/// machine-comparison format and a human sentence to share a structure, and **they would eventually
/// constrain each other** (`教训.md` §8.12).
///
/// ⚠️ **`transactionId` is nullable and `ON DELETE SET NULL` — the point of the table.**
/// One of the three example lines the owner wants to see is *"naeor 删除了 #000103 出租车记录"*:
/// **deleting an entry must not delete the record that it was deleted.** Note that
/// `TransactionConflict` uses `CASCADE` — the two look alike and mean opposite things.
model TransactionEvent {
  id     String @id @default(uuid()) @db.Uuid
  /// Which ledger. Required: history always belongs to a ledger.
  bookId String @map("book_id") @db.Uuid

  /// The entry, **null once it has been deleted** — see the note above.
  transactionId String? @map("transaction_id") @db.Uuid

  /// ⚠️ **A snapshot of the entry's number.** After a delete `transactionId` is null, and
  /// `#000103` must still be readable — otherwise the record cannot be pointed at. The number is
  /// immutable (1.09.20), so the snapshot cannot drift from the truth.
  transactionSeq Int? @map("transaction_seq")

  /// Who did it. Nullable so the record survives the account being closed; `actorName` is the
  /// snapshot that keeps it readable.
  actorId   String? @map("actor_id") @db.Uuid
  actorName String? @map("actor_name") @db.VarChar(64)

  /// `created` / `updated` / `deleted` / `restored` / `member_changed` / `book_changed`.
  ///
  /// ⚠️ **The database enforces this list** (`transaction_events_kind_known`, a CHECK constraint),
  /// and that is on purpose: a typo in a `recordEvent` call would otherwise produce a history row
  /// whose verb `KIND_VERB` cannot look up — **a crash on the history screen, days later, far from
  /// the line that caused it.** Adding a kind is therefore a migration, and that is the intended
  /// cost: the list of things a ledger can record is a decision, not a string.
  kind String @db.VarChar(24)

  /// ⚠️ **Which fields changed, and what they were before and after**:
  /// `{ "amountCents": { "from": 3500, "to": 3800 } }`. JSONB because the set of tracked fields
  /// will grow, and a column per field would need a migration each time.
  changes Json?

  /// When it happened. **One ordering field and no more** — a second would make "which came first"
  /// unanswerable.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  book        Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// ⚠️ The main query is *"what happened in this ledger recently"* — by ledger, newest first.
  @@index([bookId, occurredAt(sort: Desc)])
  /// ⚠️ The second is *"what has this entry been through"*, reached from the entry's detail screen.
  @@index([transactionId])
  @@map("transaction_events")
}

/// **账本内的公共留言 —— 围绕这本账的讨论，不是聊天。**
///
/// ⚠️ **The owner drew the boundary and it is narrow**: *"它只属于当前账本，类似一个**小型群聊或留言板**：
/// 同一本账的成员可以看到公共留言；成员可以发送文字；显示**发送者和发送时间**；**不提供私人聊天**；
/// 不需要复杂的**好友聊天体系**."*
///
/// ⚠️ **One table is the design, not a shortcut.** No private messages, no friend graph, and no
/// receipts — so **"ledger + sender + body + time" expresses everything inside that boundary.** A
/// conversations table or a participants table would be **building the skeleton of a chat system he
/// explicitly said he does not want** (`教训.md` §8.13).
///
/// ⚠️ **There is no `read_at` and no `deleted_at`.** Those are not "not yet" — the owner listed
/// *已读回执* and *消息撤回* as **not needed**. **A column added "in case it is useful later" is how
/// a rejected idea survives as a field** (`教训.md` §8.11).
model BookMessage {
  id     String @id @default(uuid()) @db.Uuid
  /// ⚠️ The message belongs to **a ledger**, not to a conversation between two people.
  bookId String @map("book_id") @db.Uuid
  senderId String @map("sender_id") @db.Uuid

  /// ⚠️ **A snapshot of the sender's name.** Renaming yourself must not rewrite the signature on
  /// messages you already sent, and closing an account must not turn them into anonymous text —
  /// the same reason `TransactionEvent.actorName` exists.
  senderName String @map("sender_name") @db.VarChar(64)

  /// ⚠️ **Bounded**, because it is free text shown to other people: **unbounded text is a channel
  /// for flooding**, and this exists to discuss entries, not to shout.
  body String @db.VarChar(500)

  /// ⚠️ **One timestamp and no `updatedAt`.** Messages cannot be edited — the owner asked for no such
  /// thing, and both *撤回* and *已读回执* are listed as unnecessary. **A field that can never change
  /// does not need two timestamps beside it.**
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt(sort: Desc)])
  @@map("book_messages")
}

/// Server-owned counters for things that are handed out in order.
///
/// The owner's requirement was that a new account must never take a number that
/// is already in use, and that two signups arriving at the same moment must not
/// be given the same one. Both are solved by not letting the client choose: the
/// counter is read and incremented inside the same transaction that creates the
/// account, so the database decides, and the unique index is the backstop.
///
/// A generic table rather than a column on `users`, because ledger numbers are
/// going to need exactly the same thing.
model Counter {
  /// `account_number`, `book_number`, …
  name String @id
  /// The next value to hand out.
  next Int    @map("next")

  @@map("counters")
}

// ---------------------------------------------------------------------------
// Books and membership
// ---------------------------------------------------------------------------

/// A ledger.
///
/// Every account gets one at signup and can belong to others by invitation. The
/// book switcher and the 首页 that lists them arrive with the collaboration
/// stage; the table has been shaped for sharing since the first migration.
model Book {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Eight-digit public ledger number, for example `40000007`.
  ///
  /// The same idea as `User.accountNumber`, and deliberate for the same reason:
  /// it can be read out loud when two people are checking they are looking at
  /// the same ledger. Unlike an account number it is **not searchable** — a
  /// ledger is joined by invitation, never by guessing a number — so it is a
  /// label rather than an address.
  ///
  /// Nullable in the schema because it was added after `books` already had rows;
  /// the migration numbers them and the allocation path fills it in from then
  /// on. **New code may assume it is set**; only a row written before this
  /// migration could be missing one, and there are none left.
  ///
  /// The number block starts at 40000000, chosen by the owner so that an account
  /// number and a ledger number are never mistaken for one another at a glance.
  bookNumber String? @unique @map("book_number") @db.VarChar(8)

  /// **The next entry number to hand out in this ledger** — `#000001` is `1`.
  ///
  /// ⚠️ **A counter rather than `MAX(seq) + 1`, and the difference is real**: a deleted entry keeps
  /// its number, so "how many have been handed out" is not "how many exist" — **the next number is a
  /// fact of its own** (`教训.md` §8.12).
  ///
  /// ⚠️ **Per ledger, on the book row, rather than in the global `counters` table.** The owner's rule
  /// is *"每一笔帐本都从 #000001 开始"* — each ledger has its own series — and a global counter can
  /// only produce one continuous run of numbers, not one per book.
  ///
  /// ⚠️ **Allocation is `UPDATE … RETURNING`, which locks this row until the transaction commits.**
  /// That is what makes two simultaneous entries for one ledger queue instead of colliding, while
  /// two different ledgers never wait for each other.
  nextTransactionSeq Int @default(1) @map("next_transaction_seq")

  /// When this ledger was **disposed of** — the owner's word, chosen deliberately
  /// over "archived" — and the meaning is specific:
  ///
  /// * **the server keeps every row** (nothing is soft-deleted, no transaction is
  ///   touched): the data is intact and an administrator can still recover it;
  /// * **the client deletes its local copy** and stops showing the ledger;
  /// * **ordinary users can no longer see it at all.**
  ///
  /// ⚠️ **Not `deleted_at`, and that is not a naming preference.** "Is this ledger
  /// still around" and "was this row deleted" are two different questions, and
  /// folding them into one column makes every later query answer the wrong one.
  ///
  /// ⚠️ **A separate thing from "I no longer want to see this book"**, which is
  /// `BookMember.leftAt`: that one hides the ledger from one person and leaves
  /// everybody else untouched. The owner asked for the two meanings to be kept
  /// apart, and they are kept apart here.
  disposedAt DateTime? @map("disposed_at") @db.Timestamptz(6)

  creator        User            @relation("BookCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members        BookMember[]
  categories     Category[]
  paymentMethods PaymentMethod[]
  tags           Tag[]
  transactions   Transaction[]
  exportLogs     ExportLog[]
  importLogs     ImportLog[]

  /// Accounts that name this book as their last-used one. The other side of
  /// `User.lastBook`.
  lastUsedBy User[] @relation("UserLastBook")

  /// Invitations into this ledger. Deleting the ledger removes them; **disposing of it does not**,
  /// because a disposed ledger still exists and can be brought back.
  invitations Notification[]

  /// Share links into this ledger, live and revoked alike. Deleting the ledger removes them,
  /// because a link into a ledger that no longer exists is a link to nothing.
  shareLinks BookShareLink[]

  /// ⚠️ The ledger's own history: who changed what, and when.
  events TransactionEvent[]

  /// ⚠️ 这本账的公共留言 —— 属于账本，不属于任何两个人之间的会话。
  messages BookMessage[]

  @@map("books")
}

/// ⚠️ **`owner` is no longer produced or read.** The owner decided to keep two
/// roles only — `editor` and `viewer` — so existing `owner` rows are converted to
/// `editor` by the collaboration migration.
///
/// The value itself stays in the enum because removing it means altering a
/// PostgreSQL type for no gain, and a migration that changes a type is a bigger
/// risk than an unused label. **No code may write it.**
///
/// ⚠️ **The distinction that matters**: `owner` of a *ledger* is gone, but
/// `Book.createdBy` still records who made it, and that is now only a fact about
/// history rather than a permission.
enum BookRole {
  owner
  editor
  viewer
}

/// Who may touch a book. **This table is the only source of truth for
/// permission checks** — never the user id sent by a client.
model BookMember {
  bookId   String   @map("book_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid

  /// ⚠️ **The default is `viewer`, and it used to be `owner`.**
  ///
  /// A default of `owner` meant any insert that forgot to pass a role handed out
  /// ownership; getting it wrong now hands out read-only access instead, which is
  /// the direction a mistake should fail in.
  ///
  /// ⚠️ **But the owner's instruction was not only "change the default"**:
  /// **creating a ledger must grant `editor` explicitly**, never by relying on
  /// this. A default is what happens when somebody forgets; it is not a design.
  role     BookRole @default(viewer)

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  /// When this person left the ledger — **which affects nobody else**.
  ///
  /// Leaving means "I no longer want to see this book": my client drops it and
  /// forgets it, while the ledger carries on exactly as before for everyone else.
  ///
  /// ⚠️ **The row is kept rather than deleted**, so it now carries two meanings
  /// that readers must tell apart:
  ///
  /// * the row exists ⟶ this account has *ever* had a relationship with the book;
  /// * `leftAt IS NULL` ⟶ they are a member **now**, and that is the only thing
  ///   permission checks may look at.
  ///
  /// Same shape as a transaction's tombstone: keep the row, let one timestamp
  /// change what it means. Joining again clears this rather than adding a row.
  leftAt DateTime? @map("left_at") @db.Timestamptz(6)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookId, userId])
  @@index([userId])
  @@index([bookId, leftAt])
  @@map("book_members")
}

// ---------------------------------------------------------------------------
// Classification
// ---------------------------------------------------------------------------

enum TransactionKind {
  income
  expense
}

/// A category belongs to one kind: income and expense each have their own set,
/// so switching to 收入 never shows 餐饮.
///
/// Categories are archived, never deleted: past entries keep pointing at them
/// and must still render correctly.
model Category {
  id         String          @id @default(uuid()) @db.Uuid
  bookId     String          @map("book_id") @db.Uuid
  name       String
  kind       TransactionKind
  /// Unused in v1 (no icons by decision), kept so adding them needs no migration.
  icon       String?
  /// Plain-language explanation of what belongs in this category.
  ///
  /// Set for the presets so a new user can tell 服务 from 生活缴费. It is
  /// cleared the moment the category is renamed: at that point it is the
  /// user's own category, and an explanation they did not write is just noise.
  description String?
  sortOrder  Int             @default(0) @map("sort_order")
  isArchived Boolean         @default(false) @map("is_archived")

  /// A system category is created with the book and managed by the server:
  /// it cannot be renamed, archived or deleted, and it never appears in the
  /// picker. `暂无分类` is the one that exists today — an entry whose author
  /// did not choose a category is filed under it, so `transactions.category_id`
  /// stays mandatory and every entry is still countable.
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([bookId, kind, name])
  @@index([bookId, kind, isArchived])
  @@map("categories")
}

/// How a payment was made (WeChat, cash, ...). v1 records this but does not
/// track balances — balances drag in transfers and reconciliation.
model PaymentMethod {
  id         String   @id @default(uuid()) @db.Uuid
  bookId     String   @map("book_id") @db.Uuid
  name       String
  icon       String?
  sortOrder  Int      @default(0) @map("sort_order")
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  book         Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([bookId, name])
  @@index([bookId, isArchived])
  @@map("payment_methods")
}

/// A cross-category label such as 出差 or 可报销.
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  book         Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([bookId, name])
  @@map("tags")
}

// ---------------------------------------------------------------------------
// Entries
// ---------------------------------------------------------------------------

/// One recorded entry.
///
/// Three things here exist purely for the offline-first design in PLAN 3.3:
///  * `id` is generated by the client, so an entry can be created offline and
///    keeps the same identity once it reaches the server
///  * `idempotency_key` makes a retried upload harmless — the same key can only
///    ever produce one row
///  * `version` plus `deleted_at` (a tombstone, never a hard delete) let a
///    device that was offline learn what changed without resurrecting data
model Transaction {
  id     String @id @db.Uuid
  bookId String @map("book_id") @db.Uuid
  /// Who recorded it.
  userId String @map("user_id") @db.Uuid

  /// **The number a person reads: `#000001`.** Per ledger, from 1, assigned by the server.
  ///
  /// ⚠️ **Not the id, and the owner drew the line himself**: *"编号跟之前的账目内部 ID 是不一样的……
  /// 编号更多是给用户看的。**程序所有的操作仍然用内部 ID**."* Every route, relation and offline mark
  /// still addresses this row by `id`; this column is a label that happens to be unique.
  ///
  /// ⚠️ **Assigned when the entry reaches the server, never on the client**: *"离线期间新增的账目
  /// 不直接生成编号；所有的编号都由服务器统一分配."* An entry typed offline carries no number until
  /// it syncs — the field is simply absent on that copy.
  ///
  /// ⚠️ **Never editable.** No request schema has a `seq` field, so a client cannot send one, and
  /// the DTO returns the stored value rather than deriving it — **a number the user has already read
  /// must not move** (`教训.md` §8.12).
  ///
  /// Unique **within its ledger**, by the constraint on `(bookId, seq)` in the migration: two
  /// ledgers each have a `#000001`, which is what "每一笔帐本都从 #000001 开始" means.
  seq Int

  /// ⚠️ **This entry's own history.** Null entries stay behind when the row is deleted —
  /// see `TransactionEvent.transactionId`.
  events TransactionEvent[]

  /// The unique value this row carried in the file it was imported from.
  ///
  /// Deliberately **not** the primary key. A file we did not produce does not
  /// get to choose our keys, and de-duplicating on this value alone would
  /// refuse a legitimate import into a second book — the unique constraint at
  /// the bottom of this model scopes it to the book instead. Null for anything
  /// typed in by hand.
  sourceRef String? @map("source_ref") @db.VarChar(64)

  /// The `In-…` reference of the import batch that created this row, if any.
  ///
  /// `source_ref` says *which row of a file* this came from, and can be a value
  /// we did not mint. This says *which import run brought it in*, and it is
  /// always ours. Manual entries leave it null. Together they make a row
  /// answerable: where did this come from, and when did it arrive.
  importRef String? @map("import_ref") @db.VarChar(32)

  /// Always set. An entry saved without a category is filed under the book's
  /// system category 暂无分类, which is never shown in the picker.
  categoryId      String @map("category_id") @db.Uuid
  paymentMethodId String? @map("payment_method_id") @db.Uuid

  /// Stored alongside the category so statistics stay correct even if the
  /// category is later reclassified or archived.
  kind TransactionKind

  /// Integer cents. Never a float: 0.1 + 0.2 != 0.3, and a cent of drift is a
  /// fatal bug in a ledger.
  amountCents BigInt @map("amount_cents")
  /// ISO 4217, uppercase. Each entry carries its own currency; v1 reports per
  /// currency and never converts.
  currency    String @db.Char(3)

  /// The instant, to the second.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  /// The local calendar date where the entry was made. Grouping, filtering and
  /// "this month" all use this, so the server never has to guess a time zone.
  occurredLocalDate DateTime @map("occurred_local_date") @db.Date
  /// IANA zone the entry was recorded in, e.g. `Asia/Shanghai`.
  occurredTz String @map("occurred_tz")

  note String?

  version        Int      @default(1)
  idempotencyKey String   @unique @map("idempotency_key") @db.Uuid

  /// Every value this row has ever held, newest last, capped at `HISTORY_LIMIT`.
  ///
  /// ⚠️ **This is what decides whether a device's value is a conflict or just a stale copy.**
  /// The owner's rule: **"除非本地设备的值不在服务器的值的历史数据中（也就是本地 A，服务器 B 到 D，
  /// 这种情况是冲突），否则一律用服务器数据覆盖本地数据."** A value the server has held before means the
  /// device merely fell behind; a value it has never held is one the device invented.
  ///
  /// ⚠️ **A JSON column rather than a history table.** A row re-edited twenty times would be twenty rows, and
  /// the only question ever asked of this data is "has this value appeared" — **which a list answers in one
  /// read without a join.** The trade is that history cannot be queried by content, which nothing needs.
  valueHistory Json @default("[]") @map("value_history")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  book          Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  tags          TransactionTag[]
  /// ⚠️ **Disagreements about this entry**, one row per field — see `TransactionConflict`.
  conflicts     TransactionConflict[]

  // The list view always asks for one book's live rows newest-first; cursor
  // pagination walks (occurred_local_date, created_at, id).
  @@index([bookId, deletedAt, occurredLocalDate(sort: Desc), createdAt(sort: Desc)])
  @@index([bookId, kind, occurredLocalDate(sort: Desc)])
  @@index([categoryId])
  @@index([paymentMethodId])
  /// The import rule, and the scoping is the point: the same file imported
  /// twice into one book changes nothing, while importing it into a second
  /// book is not blocked. Nullable, and PostgreSQL treats NULLs as distinct, so
  /// any number of hand-typed rows can share the null.
  @@unique([bookId, sourceRef])
  /// "Show me everything the 20261010-153012 import brought in."
  @@index([bookId, importRef])
  @@map("transactions")
}

/// A field two devices disagree about, waiting for somebody to settle it.
///
/// ⚠️ **The conflict lives on the server, not on the device that noticed it** — and that is what makes the
/// owner's rule work: **"如果用户已经对这个冲突做了一次确认，那说明用户已经肯定这次账单的数值了；
/// 此时没必要让用户在别的设备上再肯定一次."** A device that was offline when the decision was made finds no
/// conflict here on its next sync, adopts the settled value, and is never asked again.
///
/// ⚠️ **One row per field, not per entry.** Two devices can disagree about the amount while agreeing about
/// everything else, and **asking about the whole entry would make the user re-decide the fields nobody
/// questioned.**
model TransactionConflict {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  bookId        String   @map("book_id") @db.Uuid

  /// Which field, named as the screens name it (`amountCents`, `note`, …).
  field String @db.VarChar(32)

  /// What the server held when the conflict was recorded.
  serverValue Json @map("server_value")
  /// What each side wanted, with the device that wanted it — see `ConflictClaim`.
  claims Json @default("[]")
  /// Every value this field had held by the time the conflict was raised. **Shown to the user**, because
  /// "which value did you mean" is much easier to answer next to the history.
  history Json @default("[]")

  /// ⚠️ Null while unresolved. A resolved row is kept for a short while so every device learns the answer,
  /// then deleted — **the permanent record of what happened is `ConflictResolution` below.**
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedValue Json?    @map("resolved_value")
  resolvedBy    String?  @map("resolved_by") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  /// The sync loop looks for open conflicts for one book, every time a device acts.
  @@index([bookId, resolvedAt])
  @@index([transactionId])
  @@map("transaction_conflicts")
}

/// What happened, in full — kept after the conflict row is gone.
///
/// ⚠️ **The owner asked for this in as much detail as it takes**: "最好还能记录冲突是哪两台设备传上来的，
/// 他们传出来的结果分别是什么，服务器原来的值是什么，最后改成了什么等等，反正多几行字也占不了多少空间."
///
/// **And it is the only thing that can answer "why did this entry change by itself" a week later.**
model ConflictResolution {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  bookId        String   @map("book_id") @db.Uuid
  field         String   @db.VarChar(32)

  /// The value the server held when the disagreement was noticed.
  serverValue Json @map("server_value")
  /// One entry per device: its id, the chain it tried to send, and when it tried.
  claims Json @default("[]")

  /// What it was settled to, by which device, and when.
  resolvedValue Json      @map("resolved_value")
  resolvedBy    String    @map("resolved_by") @db.VarChar(64)
  resolvedAt    DateTime  @map("resolved_at") @db.Timestamptz(6)
  /// When the original conflict was raised.
  raisedAt DateTime @map("raised_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bookId, resolvedAt])
  @@index([transactionId])
  @@map("conflict_resolutions")
}

model TransactionTag {
  transactionId String @map("transaction_id") @db.Uuid
  tagId         String @map("tag_id") @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

// ---------------------------------------------------------------------------
// Provenance: what left this book, and what arrived in it
// ---------------------------------------------------------------------------

/// A record that an export happened.
///
/// Metadata only. The owner was explicit that the contents are not kept: no
/// rows, no file. What is here is what the export covered, how much of it there
/// was, and the `Out-…` reference the user was shown — which is what makes it
/// possible to match a file in someone's hands to the run that produced it.
///
/// The reference is also written into the exported file, on every row. That is
/// what lets an import tell "this came back to me" from "this is somebody
/// else's file".
model ExportLog {
  id     String @id @default(uuid()) @db.Uuid
  bookId String @map("book_id") @db.Uuid
  /// Who ran it.
  userId String @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// "csv" or "xlsx".
  format String @db.VarChar(8)

  /// The filter that produced it, kept as answers rather than as a query string
  /// so it stays readable when the query language changes.
  monthFrom  String?          @map("month_from") @db.VarChar(7)
  monthTo    String?          @map("month_to") @db.VarChar(7)
  kind       TransactionKind?
  categoryId String?          @map("category_id") @db.Uuid
  currency   String?          @db.Char(3)

  /// How many entries went into it.
  rowCount Int @map("row_count")

  /// Shown to the user and written into the file: `Out-20261010-153012-a3f9`.
  /// The prefix is enforced by a CHECK constraint, not by convention.
  fileRef String @unique @map("file_ref") @db.VarChar(32)

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
  @@map("export_logs")
}

/// A record that an import happened.
///
/// The import equivalent of the row above, with the numbers an import actually
/// needs to be auditable: how many rows the file held, how many were written,
/// and how many were recognised as already present and skipped. A skip is not
/// an error — it is the de-duplication rule doing its job — but it must be
/// countable, because "the file said 200 rows and my ledger grew by 187" is
/// exactly the question this table has to answer.
model ImportLog {
  id     String @id @default(uuid()) @db.Uuid
  bookId String @map("book_id") @db.Uuid
  /// Who ran it.
  userId String @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// "csv". XLSX import is not offered: the format that round-trips is the text
  /// one, and a spreadsheet is a viewing format.
  format String @db.VarChar(8)

  /// Every row the file carried is stamped with this: `In-20261010-153012-b7c2`.
  /// It is how a row in the ledger answers "where did you come from".
  fileRef String @unique @map("file_ref") @db.VarChar(32)

  /// The `Out-…` reference of the export this file appears to be, when it is
  /// one of ours. Null for a file from somewhere else.
  exportedFileRef String? @map("exported_file_ref") @db.VarChar(32)

  /// SHA-256 of the uploaded bytes. Lets a user settle "did I already import
  /// this exact file" without keeping the file.
  sourceFingerprint String @map("source_fingerprint") @db.VarChar(64)

  /// Rows the file declared.
  rowCount Int @map("row_count")
  /// Rows written to the ledger.
  importedCount Int @map("imported_count")
  /// Rows recognised as already present in this book.
  skippedCount Int @map("skipped_count")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
  @@map("import_logs")
}

/// **Platform administration, granted to one account on purpose.**
///
/// ⚠️ **This table exists because `users.is_admin` was not enough, and the reason is not
/// cosmetic.** A boolean on the user row says *that* somebody is an administrator and
/// nothing else: no record of who decided, no date, and no way to revoke it that is
/// distinguishable from the grant itself. This is the **authorization half** of the admin
/// check, and it is deliberate that it is a different fact from the allow list the guard
/// also consults — see `apps/api/src/admin/guard.ts` and
/// `docs/管理员与权限边界-设计决定.md`.
///
/// Four things worth knowing, all of them decisions rather than accidents:
///
///  * **One row per account** (`userId` is the primary key). "Is this account authorized"
///    is a question with one answer, and a second live grant would be a second answer.
///    Re-granting after a revocation **revives this row** rather than adding another, which
///    is what keeps the history on a single line.
///  * **`revokedAt` rather than a delete.** Revoking is a fact about the past; deleting the
///    row would erase the evidence that the account ever held the role, which is exactly
///    what an audit would need. The guard ignores revoked rows, so revocation takes effect
///    on the next request — **nothing caches this**, deliberately: a cached admin decision
///    is an administrator who cannot be fired.
///  * **`grantedBy` is free text, not a foreign key.** The person who runs the grant script
///    is the machine owner at a terminal, and they may not have an account in the
///    application at all. A foreign key would force a row that does not exist, or invite a
///    fake one.
///  * **`Cascade` on delete.** Deleting the account removes its authorization. The
///    alternative — a grant row pointing at nobody — is a privilege waiting for a UUID to
///    be reused, and UUID reuse is not something to leave to chance.
///
/// ⚠️ **Being an administrator is not a licence to read other people's ledgers.** Ledger
/// access comes from `book_members` and from nothing else; this table grants the ability to
/// perform *platform* operations, each of which still has to define its own scope. See
/// `docs/管理员与权限边界-设计决定.md` §6.
model AdminGrant {
  /// The account that holds the grant. One row per account, by construction.
  userId String @id @map("user_id") @db.Uuid

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  /// Who ran the grant. Free text on purpose — see the note above.
  grantedBy String @map("granted_by") @db.VarChar(200)

  /// When administration was taken away. Null means "currently holds it".
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.VarChar(200)

  /// Why it was revoked, for whoever reads this later. Optional because the reason is
  /// sometimes "the owner said so", which is a real reason and a short one.
  note String? @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
  @@map("admin_grants")
}

/// **The accounts administration may currently be exercised as — the second, independent
/// half of the admin check.**
///
/// ⚠️ **This table exists because the first attempt at the second check was not really a
/// second check** (2026-10-14, 1.10.23). The guard's allow-list half used to answer by
/// deriving the list from `admin_grants` — *"is this account granted **and** first-batch?"* —
/// which reads like a pair of conditions and behaves like one condition. **A grant alone
/// then satisfied both halves**, so the two checks could never disagree, and the whole point
/// of asking twice was lost. The owner spotted it: *"授权记录和允许名单并没有完全分离"*.
///
/// What the two halves must be is **two facts, stored twice, revocable separately**:
///
/// | | `admin_grants` | `admin_allowlist` (this table) |
/// |---|---|---|
/// | Question | *"has this account been granted the role?"* | *"is this account one of the accounts administration may run as?"* |
/// | Written by | `pnpm admin:grant` | `pnpm admin:allow` |
/// | Removed by | `pnpm admin:revoke` | `pnpm admin:disallow` |
/// | Can be present alone | ✅ — and then the guard **refuses** | ✅ — and then the guard **refuses** |
///
/// ⚠️ **Nothing derives one from the other, and that is enforced in both directions.**
/// `pnpm admin:grant` does **not** add a list entry, and `pnpm admin:allow` does **not**
/// create a grant. An operator has to mean both. The regression test that pins this is
/// *"a second eligible account with a grant but no listing is still refused"* — a guard that
/// derived the list would pass every other test in the suite and fail only that one.
///
/// ⚠️ **The migration that created this table inserted no rows.** A list that arrives
/// pre-populated is a privilege nobody decided on; adding the first account is a deliberate
/// command run against a named UUID.
///
/// ⚠️ **`revoked_at` rather than a delete**, for the same reason as `AdminGrant`: taking
/// somebody off the list is a fact about the past, and the record of it is what an incident
/// review reads. The guard reads only unrevoked rows, so removal takes effect on the next
/// request — nothing is cached.
model AdminAllowEntry {
  /// The account permitted to exercise administration. This **is** the stored UUID the
  /// brief asks to be checked independently of any role record.
  userId String @id @map("user_id") @db.Uuid

  listedAt DateTime @default(now()) @map("listed_at") @db.Timestamptz(6)

  /// Who put the account on the list. Free text, for the same reason as `AdminGrant.grantedBy`.
  listedBy String @map("listed_by") @db.VarChar(200)

  /// When the account was taken off the list. Null means "on the list now".
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.VarChar(200)

  note String? @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([revokedAt])
  @@map("admin_allowlist")
}
