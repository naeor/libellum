// Libellum database schema.
//
// Design notes that matter (see docs/PLAN.md section 5):
//  * money is stored as an integer number of cents, never as a float
//  * every business table carries a book_id, and permissions are decided by
//    book_members alone
//  * v1 gives every account its own book; the Book/BookMember tables already
//    exist so that v2 can add sharing without a data migration
//  * rows are never hard-deleted: soft delete plus a version column is what
//    lets an offline client sync without resurrecting deleted data

generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  /// Short, human-readable identifier shown in the UI (for example
  /// `LB-7F3K-9M2Q`). The UUID above is internal; this is the one a person can
  /// read out or quote when asking for help.
  accountNumber String  @unique @map("account_number")
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isDemo       Boolean  @default(false) @map("is_demo")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Hash of the one-time recovery code. The plaintext is shown exactly once,
  /// when it is created, and can never be recovered from the database again.
  recoveryCodeHash   String?   @map("recovery_code_hash")
  recoveryCodeUsedAt DateTime? @map("recovery_code_used_at") @db.Timestamptz(6)

  session Session?
  invite  RegistrationInvite?

  @@map("users")
}

/// A login session.
///
/// `user_id` is unique on purpose: the project allows exactly one active
/// session per account, so signing in on a new device replaces the previous
/// one. That makes "one device at a time" enforceable and removes the hardest
/// offline-merge case.
///
/// Only the hash of the session token is stored, so a database leak cannot be
/// replayed as a valid session.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Single-use code required to create an account.
///
/// The project is open source but deliberately not open registration: running
/// the server costs money and the tool is meant for a family, so accounts are
/// created with an invite generated by the owner.
model RegistrationInvite {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  usedByUserId String?   @unique @map("used_by_user_id") @db.Uuid
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)

  usedBy User? @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@map("registration_invites")
}
