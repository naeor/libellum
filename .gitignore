# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
build/
*.tsbuildinfo

# ---- Prisma 生成的客户端代码（由 pnpm db:generate 产出，不进仓库）----
apps/api/src/generated/

