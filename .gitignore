# ---- 依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
dist/
build/
*.tsbuildinfo

# ---- Prisma 生成的客户端代码（由 pnpm db:generate 产出，不进仓库）----
apps/api/src/generated/

# ---- 环境变量与密钥：绝对不要提交 ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---- 数据库与备份 ----
pgdata/
backups/
*.sql.gz
*.dump

# ---- 上传的小票图片（本地开发）----
uploads/

# ---- OCR 服务：Python 虚拟环境与模型（本地安装，约 260MB）----
# 依赖由 requirements.txt 声明；虚拟环境本身永远不进仓库。
apps/ocr/.venv/
apps/ocr/__pycache__/
# 测试用的仿真截图由 make_samples.py 生成，不必提交。
# 真实截图绝不允许提交——那是别人的付款凭证。
apps/ocr/samples/
# 项目所有者提供的真实截图：含金额、姓名、卡号。
# 绝不进仓库，也绝不上传到任何地方。
apps/ocr/real-samples/*
!apps/ocr/real-samples/README.md

# ---- 日志与临时文件 ----
*.log
*.err
npm-debug.log*
pnpm-debug.log*
logs/
tmp/

# ---- 测试与覆盖率 ----
coverage/
.nyc_output/

# ---- 编辑器与系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 本项目文档流水线的临时产物 ----
docs/_pv_*/
docs/_c*.json

# ---- 文档导出产物（Markdown 是源文件，导出件不必进仓库）----
# 如果你希望简历里直接看到 PDF，把下面两行删掉即可
docs/*.docx
docs/*.pdf

# ---- 本地快捷方式 ----
# 指向本机绝对路径（含用户名），对别人没有意义，也不该进公开仓库。
docs/*.lnk

# ---- 导出功能自检时落盘的样例文件 ----
_check-export.csv
_check-export.xlsx
