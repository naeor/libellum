# 统一换行符：仓库里一律用 LF，避免 Windows/macOS 协作时出现"整个文件都改了"
* text=auto eol=lf

# 二进制文件不要做文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary
*.woff binary
*.woff2 binary
*.pdf binary

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 锁文件在 GitHub 上折叠显示
pnpm-lock.yaml linguist-generated=true
