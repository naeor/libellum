{
  "name": "@libellum/api",
  "version": "0.1.0",
  "private": true,
  "description": "Libellum API server",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "invite:create": "node --env-file-if-exists=../../.env --import tsx src/scripts/create-invite.ts",
    "invite:batch": "node --env-file-if-exists=../../.env --import tsx src/scripts/create-invite-batch.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@libellum/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.6",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
